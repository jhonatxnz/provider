<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- JSON file using the Logstash event template: gives a real "@timestamp" (ISO-8601, ms precision,
             generated by the app itself) plus "message", "level", "logger_name" and "stack_trace" fields. -->
        <RollingFile name="JsonFile" fileName="logs/provider.log" filePattern="logs/provider-%d{yyyy-MM-dd}-%i.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:LogstashJsonEventLayoutV1.json"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>

        <!-- OpenSearch logs filter: DEBUG+ -->
        <Logger name="br.com.jhonatan.provider" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonFile"/>
        </Logger>

        <!--console level: INFO        -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonFile" level="WARN"/>
        </Root>

    </Loggers>
</Configuration>